<Window x:Class="LiteCad.UI.Help.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LiteCad.Resources"
        Title="{loc:Loc Key=Dialog.Feedback.Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,24"
                HorizontalAlignment="Center"
                MaxWidth="360">
        <TextBlock Text="{loc:Loc Key=Help.Feedback.Hint}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Style="{DynamicResource CadSectionLabelStyle}"
                   Margin="0,0,0,16" />

        <Image Source="/Assets/FeedbackQr.png"
               Width="280"
               Stretch="Uniform"
               Cursor="Hand"
               MouseLeftButtonUp="QrImage_OnMouseLeftButtonUp"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <TextBlock Margin="0,16,0,0"
                   HorizontalAlignment="Center"
                   FontSize="14">
            <Hyperlink NavigateUri="https://t.me/my_cool_software_fb_bot"
                       RequestNavigate="BotLink_OnRequestNavigate">
                <Run x:Name="BotHandleRun" />
            </Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
