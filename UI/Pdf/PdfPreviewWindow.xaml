<Window x:Class="LiteCad.UI.Pdf.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LiteCad.Resources"
        Title="{loc:Loc Key=Dialog.PdfPreview.Title}"
        Width="920"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CadBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc Key=Dialog.PdfPreview.Title}"
                   Style="{StaticResource CadPanelHeaderStyle}"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="#D8D8D8"
                BorderBrush="{StaticResource CadBorderBrush}"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <ScrollViewer x:Name="PreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="PreviewScrollViewer_OnPreviewMouseWheel">
                    <Viewbox x:Name="PreviewViewbox"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Image x:Name="PreviewImage"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="PreviewImage_OnMouseLeftButtonDown"
                               MouseMove="PreviewImage_OnMouseMove"
                               MouseLeftButtonUp="PreviewImage_OnMouseLeftButtonUp"
                               MouseLeave="PreviewImage_OnMouseLeave" />
                    </Viewbox>
                </ScrollViewer>

                <TextBlock Text="{loc:Loc Key=Label.PdfPreviewHint}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8"
                           Opacity="0.75"
                           FontSize="11"
                           Foreground="#333333" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{loc:Loc Key=Label.PdfFormat}"
                       Style="{StaticResource CadSectionLabelStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBlock Grid.Column="1"
                       Text="A4"
                       Style="{StaticResource CadPropertyValueStyle}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="{loc:Loc Key=Label.PdfOrientation}"
                       Style="{StaticResource CadSectionLabelStyle}"
                       VerticalAlignment="Center"
                       Margin="24,0,8,0" />
            <ComboBox Grid.Column="3"
                      x:Name="OrientationCombo"
                      Style="{StaticResource CadComboBoxStyle}"
                      MinWidth="160"
                      SelectionChanged="OrientationCombo_OnSelectionChanged">
                <ComboBoxItem Content="{loc:Loc Key=PdfOrientation.Portrait}" Tag="Portrait" IsSelected="True" />
                <ComboBoxItem Content="{loc:Loc Key=PdfOrientation.Landscape}" Tag="Landscape" />
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="{loc:Loc Key=Button.Cancel}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="CancelButton_OnClick" />
            <Button x:Name="SaveButton"
                    Content="{loc:Loc Key=Button.SavePdf}"
                    MinWidth="120"
                    Padding="12,6"
                    IsDefault="True"
                    Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
