<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme color palette -->
    <Color x:Key="Cad.Background">#F0F0F0</Color>
    <Color x:Key="Cad.Panel">#E8E8E8</Color>
    <Color x:Key="Cad.PropertiesBackground">#FAFAFA</Color>
    <Color x:Key="Cad.Border">#CCCCCC</Color>
    <Color x:Key="Cad.BorderLight">#E0E0E0</Color>
    <Color x:Key="Cad.BorderDark">#B0B0B0</Color>
    <Color x:Key="Cad.TextPrimary">#222222</Color>
    <Color x:Key="Cad.TextSecondary">#666666</Color>
    <Color x:Key="Cad.TextMuted">#999999</Color>
    <Color x:Key="Cad.Accent">#2196F3</Color>
    <Color x:Key="Cad.AccentLight">#D6EBFF</Color>
    <Color x:Key="Cad.Hover">#E4E4E4</Color>
    <Color x:Key="Cad.InputBackground">#FFFFFF</Color>
    <Color x:Key="Cad.InputDisabled">#ECECEC</Color>
    <Color x:Key="Cad.InputActive">#FFFFFF</Color>
    <Color x:Key="Cad.CanvasBackground">#FFFFFF</Color>
    <Color x:Key="Cad.ToolTipBackground">#FFFFFF</Color>
    <Color x:Key="Cad.IconDisabled">#AAAAAA</Color>
    <Color x:Key="Cad.MenuForeground">#222222</Color>
    <Color x:Key="Cad.MenuPopupBackground">#FFFFFF</Color>
    <Color x:Key="Cad.MenuHover">#E4E4E4</Color>
    <Color x:Key="Cad.MenuBorder">#CCCCCC</Color>
    <Color x:Key="Cad.MenuDisabledForeground">#999999</Color>
    <Color x:Key="Cad.PropertiesPanelText">#222222</Color>
    <Color x:Key="Cad.PropertiesControlBackground">#FFFFFF</Color>
    <Color x:Key="Cad.PropertiesControlForeground">#222222</Color>
    <Color x:Key="Cad.PropertiesControlBorder">#CCCCCC</Color>
    <Color x:Key="Cad.PropertiesControlHover">#E4E4E4</Color>
    <Color x:Key="Cad.PropertiesControlActive">#FFFFFF</Color>
    <Color x:Key="Cad.PropertiesControlDisabled">#ECECEC</Color>
    <Color x:Key="Cad.PropertiesControlDisabledForeground">#999999</Color>
    <Color x:Key="Cad.PropertiesDropdownBackground">#FFFFFF</Color>
    <Color x:Key="Cad.PropertiesDropdownForeground">#222222</Color>
    <Color x:Key="Cad.ToolButtonBackground">#00000000</Color>
    <Color x:Key="Cad.ToolButtonHover">#E4E4E4</Color>
    <Color x:Key="Cad.ToolButtonPressed">#CCCCCC</Color>
    <Color x:Key="Cad.ToolButtonBorder">#00000000</Color>
    <Color x:Key="Cad.ToolButtonPressedBorder">#B0B0B0</Color>

    <!-- WPF MenuItem popup/submenu templates use SystemColors -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#222222" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#F0F0F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#222222" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#E4E4E4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#CCCCCC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#222222" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E4E4E4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#222222" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#999999" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E4E4E4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#999999" />

    <!-- WPF MenuItem popup templates (SubmenuContent / SubMenuBorder) -->
    <SolidColorBrush x:Key="Menu.Background" Color="{StaticResource Cad.MenuPopupBackground}" />
    <SolidColorBrush x:Key="Menu.Border" Color="{StaticResource Cad.MenuBorder}" />
    <SolidColorBrush x:Key="MenuItem.SubLevel.Static.Background" Color="{StaticResource Cad.MenuPopupBackground}" />
    <SolidColorBrush x:Key="MenuItem.SubLevel.Static.Foreground" Color="{StaticResource Cad.MenuForeground}" />
    <SolidColorBrush x:Key="MenuItem.SubLevel.Static.Border" Color="{StaticResource Cad.MenuPopupBackground}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="{StaticResource Cad.MenuHover}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Foreground" Color="{StaticResource Cad.MenuForeground}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="{StaticResource Cad.MenuBorder}" />
    <SolidColorBrush x:Key="MenuItem.Disabled.Foreground" Color="{StaticResource Cad.MenuDisabledForeground}" />

    <SolidColorBrush x:Key="CadBackgroundBrush" Color="{StaticResource Cad.Background}" />
    <SolidColorBrush x:Key="CadPanelBrush" Color="{StaticResource Cad.Panel}" />
    <SolidColorBrush x:Key="CadPropertiesBackgroundBrush" Color="{StaticResource Cad.PropertiesBackground}" />
    <SolidColorBrush x:Key="CadBorderBrush" Color="{StaticResource Cad.Border}" />
    <SolidColorBrush x:Key="CadBorderLightBrush" Color="{StaticResource Cad.BorderLight}" />
    <SolidColorBrush x:Key="CadBorderDarkBrush" Color="{StaticResource Cad.BorderDark}" />
    <SolidColorBrush x:Key="CadTextPrimaryBrush" Color="{StaticResource Cad.TextPrimary}" />
    <SolidColorBrush x:Key="CadTextSecondaryBrush" Color="{StaticResource Cad.TextSecondary}" />
    <SolidColorBrush x:Key="CadTextMutedBrush" Color="{StaticResource Cad.TextMuted}" />
    <SolidColorBrush x:Key="CadAccentBrush" Color="{StaticResource Cad.Accent}" />
    <SolidColorBrush x:Key="CadAccentLightBrush" Color="{StaticResource Cad.AccentLight}" />
    <SolidColorBrush x:Key="CadHoverBrush" Color="{StaticResource Cad.Hover}" />
    <SolidColorBrush x:Key="CadInputBackgroundBrush" Color="{StaticResource Cad.InputBackground}" />
    <SolidColorBrush x:Key="CadInputDisabledBrush" Color="{StaticResource Cad.InputDisabled}" />
    <SolidColorBrush x:Key="CadInputActiveBrush" Color="{StaticResource Cad.InputActive}" />
    <SolidColorBrush x:Key="CadCanvasBackgroundBrush" Color="{StaticResource Cad.CanvasBackground}" />
    <SolidColorBrush x:Key="CadToolTipBackgroundBrush" Color="{StaticResource Cad.ToolTipBackground}" />
    <SolidColorBrush x:Key="CadIconBrush" Color="{StaticResource Cad.TextPrimary}" />
    <SolidColorBrush x:Key="CadIconDisabledBrush" Color="{StaticResource Cad.IconDisabled}" />
    <SolidColorBrush x:Key="CadMenuForegroundBrush" Color="{StaticResource Cad.MenuForeground}" />
    <SolidColorBrush x:Key="CadMenuPopupBackgroundBrush" Color="{StaticResource Cad.MenuPopupBackground}" />
    <SolidColorBrush x:Key="CadMenuHoverBrush" Color="{StaticResource Cad.MenuHover}" />
    <SolidColorBrush x:Key="CadMenuBorderBrush" Color="{StaticResource Cad.MenuBorder}" />
    <SolidColorBrush x:Key="CadMenuDisabledForegroundBrush" Color="{StaticResource Cad.MenuDisabledForeground}" />
    <SolidColorBrush x:Key="CadPropertiesPanelTextBrush" Color="{StaticResource Cad.PropertiesPanelText}" />
    <SolidColorBrush x:Key="CadPropertiesControlBackgroundBrush" Color="{StaticResource Cad.PropertiesControlBackground}" />
    <SolidColorBrush x:Key="CadPropertiesControlForegroundBrush" Color="{StaticResource Cad.PropertiesControlForeground}" />
    <SolidColorBrush x:Key="CadPropertiesControlBorderBrush" Color="{StaticResource Cad.PropertiesControlBorder}" />
    <SolidColorBrush x:Key="CadPropertiesControlHoverBrush" Color="{StaticResource Cad.PropertiesControlHover}" />
    <SolidColorBrush x:Key="CadPropertiesControlActiveBrush" Color="{StaticResource Cad.PropertiesControlActive}" />
    <SolidColorBrush x:Key="CadPropertiesControlDisabledBrush" Color="{StaticResource Cad.PropertiesControlDisabled}" />
    <SolidColorBrush x:Key="CadPropertiesControlDisabledForegroundBrush" Color="{StaticResource Cad.PropertiesControlDisabledForeground}" />
    <SolidColorBrush x:Key="CadPropertiesDropdownBackgroundBrush" Color="{StaticResource Cad.PropertiesDropdownBackground}" />
    <SolidColorBrush x:Key="CadPropertiesDropdownForegroundBrush" Color="{StaticResource Cad.PropertiesDropdownForeground}" />
    <SolidColorBrush x:Key="CadToolButtonBackgroundBrush" Color="{StaticResource Cad.ToolButtonBackground}" />
    <SolidColorBrush x:Key="CadToolButtonHoverBrush" Color="{StaticResource Cad.ToolButtonHover}" />
    <SolidColorBrush x:Key="CadToolButtonPressedBrush" Color="{StaticResource Cad.ToolButtonPressed}" />
    <SolidColorBrush x:Key="CadToolButtonBorderBrush" Color="{StaticResource Cad.ToolButtonBorder}" />
    <SolidColorBrush x:Key="CadToolButtonPressedBorderBrush" Color="{StaticResource Cad.ToolButtonPressedBorder}" />

</ResourceDictionary>
