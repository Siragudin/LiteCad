<UserControl x:Class="LiteCad.UI.Layout.ToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LiteCad.Resources"
             mc:Ignorable="d"
             d:DesignHeight="36"
             d:DesignWidth="800">
    <Border Style="{StaticResource CadToolbarPanelStyle}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="ToolButtonPanel"
                        Orientation="Horizontal"
                        Margin="4,2"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Selection"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Selection}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconFillPathStyle}" Data="{StaticResource Icon.Select}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Hand"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Hand}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconFillPathStyle}" Data="{StaticResource Icon.Hand}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Line"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Line}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Line}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Axis"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Axis}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Axis}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Arc"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Arc}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Arc}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Rectangle"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Rectangle}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Rectangle}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Circle"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Circle}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Circle}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Sector"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Sector}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconFillPathStyle}" Data="{StaticResource Icon.Sector}" />
                </Button>

                <Separator Style="{StaticResource CadToolbarSeparatorStyle}" />

                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Move"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Move}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Move}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Rotate"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Rotate}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Rotate}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Mirror"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Mirror}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Mirror}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Offset"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Offset}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Offset}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Stretch"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Stretch}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Stretch}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Extend"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Extend}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Extend}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Dimension"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Dimension}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.Dimension}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Eraser"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Eraser}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconFillPathStyle}" Data="{StaticResource Icon.Eraser}" />
                </Button>
                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="Fill"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.Fill}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconFillPathStyle}" Data="{StaticResource Icon.Fill}" />
                </Button>

                <Separator Style="{StaticResource CadToolbarSeparatorStyle}" />

                <Button Style="{StaticResource CadToolButtonStyle}"
                        Tag="PolygonEdit"
                        ToolTip="{loc:Loc Key=Tooltip.Tool.PolygonEdit}"
                        Click="ToolButton_OnClick">
                    <Path Style="{StaticResource CadToolIconPathStyle}" Data="{StaticResource Icon.PolygonEdit}" />
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
