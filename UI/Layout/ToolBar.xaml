<UserControl x:Class="LiteCad.UI.Layout.ToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="36" d:DesignWidth="800">
    <Border Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
        <ToolBarTray Background="Transparent">
            <ToolBar Background="Transparent" Band="0" BandIndex="0">
                <Button Content="Select" Width="64" Padding="6,4" Tag="Selection" Click="ToolButton_OnClick" />
                <Button Content="Hand" Width="64" Padding="6,4" Tag="Hand" Click="ToolButton_OnClick" />
                <Button Content="Line" Width="64" Padding="6,4" Tag="Line" Click="ToolButton_OnClick" />
                <Button Content="Rect" Width="64" Padding="6,4" Tag="Rectangle" Click="ToolButton_OnClick" />
                <Button Content="Axis" Width="64" Padding="6,4" Tag="Axis" Click="ToolButton_OnClick" />
                <Button Content="Wall" Width="64" Padding="6,4" Tag="Wall" Click="ToolButton_OnClick" />
                <Separator />
                <Button Content="Polyline" Width="72" Padding="6,4" Tag="Polyline" Click="ToolButton_OnClick" />
                <Separator />
                <Button Content="Move" Width="64" Padding="6,4" Tag="Move" Click="ToolButton_OnClick" />
                <Button Content="Copy" Width="64" Padding="6,4" Tag="Copy" Click="ToolButton_OnClick" />
                <Button Content="Delete" Width="64" Padding="6,4" Tag="Delete" Click="ToolButton_OnClick" />
                <Separator />
                <Button Content="Edit" Width="64" Padding="6,4" Tag="PolygonEdit" Click="ToolButton_OnClick" />
            </ToolBar>
        </ToolBarTray>
    </Border>
</UserControl>
