<UserControl x:Class="LiteCad.UI.Layout.ToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LiteCad.Resources"
             mc:Ignorable="d"
             d:DesignHeight="36" d:DesignWidth="800">
    <Border Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
        <ToolBarTray Background="Transparent">
            <ToolBar Background="Transparent" Band="0" BandIndex="0">
                <Button Content="{loc:Loc Key=Tool.Select.Short}" Width="64" Padding="6,4" Tag="Selection" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Hand}" Width="64" Padding="6,4" Tag="Hand" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Line}" Width="64" Padding="6,4" Tag="Line" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Arc.Short}" Width="64" Padding="6,4" Tag="Arc" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Rectangle.Short}" Width="64" Padding="6,4" Tag="Rectangle" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Circle.Short}" Width="64" Padding="6,4" Tag="Circle" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Sector.Short}" Width="64" Padding="6,4" Tag="Sector" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Axis}" Width="64" Padding="6,4" Tag="Axis" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Wall}" Width="64" Padding="6,4" Tag="Wall" Click="ToolButton_OnClick" />
                <Separator />
                <Button Content="{loc:Loc Key=Tool.Move}" Width="64" Padding="6,4" Tag="Move" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Rotate}" Width="64" Padding="6,4" Tag="Rotate" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Stretch}" Width="64" Padding="6,4" Tag="Stretch" Click="ToolButton_OnClick" />
                <Button Content="{loc:Loc Key=Tool.Eraser.Short}" Width="64" Padding="6,4" Tag="Eraser" Click="ToolButton_OnClick" />
                <Separator />
                <Button Content="{loc:Loc Key=Tool.Edit.Short}" Width="64" Padding="6,4" Tag="PolygonEdit" Click="ToolButton_OnClick" />
            </ToolBar>
        </ToolBarTray>
    </Border>
</UserControl>
