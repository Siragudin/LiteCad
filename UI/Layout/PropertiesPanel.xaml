<UserControl x:Class="LiteCad.UI.Layout.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LiteCad.Resources"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="260">
    <Border Style="{StaticResource CadPropertiesPanelStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                <TextBlock Text="{loc:Loc Key=Label.Properties}"
                           Style="{StaticResource CadPanelHeaderStyle}" />
                <Border Height="1"
                        Margin="0,8,0,0"
                        Background="{DynamicResource CadBorderLightBrush}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="12,0,12,12">
                <StackPanel>
                    <StackPanel Style="{StaticResource CadPropertySectionStyle}">
                        <TextBlock Text="{loc:Loc Key=Label.Tool}"
                                  Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                        <TextBlock x:Name="ActiveToolText"
                                   Text="{loc:Loc Key=Label.None}"
                                   Style="{StaticResource CadPropertiesValueStyle}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource CadPropertySectionStyle}">
                        <TextBlock Text="{loc:Loc Key=Label.Selection}"
                                  Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                        <TextBlock x:Name="SelectionText"
                                   Text="{loc:Loc Key=Selection.NothingSelected}"
                                   Style="{StaticResource CadPropertiesValueStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="LineToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.LineParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Color}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="LineColorCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="LineColorCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Black}" Tag="Black" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Gray}" Tag="Gray" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Blue}" Tag="Blue" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Red}" Tag="Red" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Green}" Tag="Green" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Thickness}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="LineThicknessCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="LineThicknessCombo_OnSelectionChanged">
                                <ComboBoxItem Content="1.0" Tag="1" />
                                <ComboBoxItem Content="1.5" Tag="1.5" IsSelected="True" />
                                <ComboBoxItem Content="2.0" Tag="2" />
                                <ComboBoxItem Content="3.0" Tag="3" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Type}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="LineTypeCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="LineTypeCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.LineType.Solid}" Tag="Solid" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.LineType.Dashed}" Tag="Dashed" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.LineType.Dotted}" Tag="Dotted" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="OrthoCheckBox"
                                  Style="{StaticResource CadPropertiesCheckBoxStyle}"
                                  Content="{loc:Loc Key=Label.OrthoHorizontalVertical}"
                                  Checked="OrthoCheckBox_OnChanged"
                                  Unchecked="OrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="AxisToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.Axis}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="AxisOrthoCheckBox"
                                  Style="{StaticResource CadPropertiesCheckBoxStyle}"
                                  Content="{loc:Loc Key=Label.OrthoHorizontalVertical}"
                                  IsChecked="True"
                                  Checked="AxisOrthoCheckBox_OnChanged"
                                  Unchecked="AxisOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="MoveToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.MoveParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="MoveOrthoCheckBox"
                                  Style="{StaticResource CadPropertiesCheckBoxStyle}"
                                  Content="{loc:Loc Key=Label.Ortho}"
                                  Checked="MoveOrthoCheckBox_OnChanged"
                                  Unchecked="MoveOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="MirrorToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.MirrorParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="MirrorOrthoCheckBox"
                                  Style="{StaticResource CadPropertiesCheckBoxStyle}"
                                  Content="{loc:Loc Key=Label.Ortho}"
                                  Checked="MirrorOrthoCheckBox_OnChanged"
                                  Unchecked="MirrorOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="OffsetToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.OffsetParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="OffsetAxisCheckBox"
                                  Style="{StaticResource CadPropertiesCheckBoxStyle}"
                                  Content="{loc:Loc Key=Label.OffsetAxes}"
                                  ToolTip="{loc:Loc Key=Tooltip.OffsetAxes}"
                                  Checked="OffsetAxisCheckBox_OnChanged"
                                  Unchecked="OffsetAxisCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="DimensionToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.DimensionParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.DimensionTextSize}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBox x:Name="DimensionToolTextSizeTextBox"
                                     Style="{StaticResource CadPropertiesTextBoxStyle}"
                                     LostFocus="DimensionToolTextSizeTextBox_OnCommit"
                                     KeyDown="DimensionToolTextSizeTextBox_OnKeyDown" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.DimensionExtensions}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="DimensionToolExtensionStyleCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="DimensionToolExtensionStyleCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.DimensionExtensionStyle.Full}" Tag="Full" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.DimensionExtensionStyle.Short}" Tag="Short" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="DimensionOrthoCheckBox"
                                  Style="{StaticResource CadPropertiesCheckBoxStyle}"
                                  Content="{loc:Loc Key=Label.Ortho}"
                                  Checked="DimensionOrthoCheckBox_OnChanged"
                                  Unchecked="DimensionOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="FillToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.FaceFill}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Color}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="FillToolColorCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="FillToolColorCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.LightGray}" Tag="LightGray" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Black}" Tag="Black" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Gray}" Tag="Gray" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Blue}" Tag="Blue" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Red}" Tag="Red" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Green}" Tag="Green" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.FillPattern}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="FillToolPatternCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="FillToolPatternCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.FillPattern.Solid}" Tag="Solid" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.FillPattern.Diagonal}" Tag="Diagonal" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.FillPattern.DiagonalWide}" Tag="DiagonalWide" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="TextToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.TextParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.TextMode}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="TextToolModeCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="TextToolModeCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.TextMode.Plain}" Tag="Plain" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.TextMode.Arrow}" Tag="Arrow" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.DimensionTextSize}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBox x:Name="TextToolTextSizeTextBox"
                                     Style="{StaticResource CadPropertiesTextBoxStyle}"
                                     LostFocus="TextToolTextSizeTextBox_OnCommit"
                                     KeyDown="TextToolTextSizeTextBox_OnKeyDown" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="DimensionSelectionPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.DimensionParameters}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Offset}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBox x:Name="DimensionOffsetTextBox"
                                     Style="{StaticResource CadPropertiesTextBoxStyle}"
                                     LostFocus="DimensionOffsetTextBox_OnCommit"
                                     KeyDown="DimensionOffsetTextBox_OnKeyDown" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.DimensionTextSize}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBox x:Name="DimensionTextSizeTextBox"
                                     Style="{StaticResource CadPropertiesTextBoxStyle}"
                                     LostFocus="DimensionTextSizeTextBox_OnCommit"
                                     KeyDown="DimensionTextSizeTextBox_OnKeyDown" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.DimensionExtensions}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="DimensionExtensionStyleCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="DimensionExtensionStyleCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.DimensionExtensionStyle.Full}" Tag="Full" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.DimensionExtensionStyle.Short}" Tag="Short" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="AxisSelectionPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.Axis}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Start}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBlock x:Name="AxisStartText"
                                       Style="{StaticResource CadPropertiesValueStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.End}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBlock x:Name="AxisEndText"
                                       Style="{StaticResource CadPropertiesValueStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.LengthValue}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <TextBlock x:Name="AxisLengthText"
                                       Style="{StaticResource CadPropertiesValueStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="FaceSelectionPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.FaceFill}"
                                   Style="{StaticResource CadPropertiesSectionLabelStyle}"
                                   Margin="0,0,0,8" />

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.Color}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="FaceFillColorCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="FaceFillColorCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.LightGray}" Tag="LightGray" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Black}" Tag="Black" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Gray}" Tag="Gray" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Blue}" Tag="Blue" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Red}" Tag="Red" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.Color.Green}" Tag="Green" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource CadPropertyFieldStyle}">
                            <TextBlock Text="{loc:Loc Key=Label.FillPattern}"
                                       Style="{StaticResource CadPropertiesSectionLabelStyle}" />
                            <ComboBox x:Name="FaceFillPatternCombo"
                                      Style="{StaticResource CadPropertiesComboBoxStyle}"
                                      SelectionChanged="FaceFillPatternCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=Label.FillPattern.Solid}" Tag="Solid" IsSelected="True" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.FillPattern.Diagonal}" Tag="Diagonal" />
                                <ComboBoxItem Content="{loc:Loc Key=Label.FillPattern.DiagonalWide}" Tag="DiagonalWide" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="NoParametersText"
                               Text="{loc:Loc Key=Label.NoParameters}"
                               FontSize="13"
                               Foreground="{DynamicResource CadTextMutedBrush}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
