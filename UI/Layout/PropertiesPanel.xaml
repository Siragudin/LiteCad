<UserControl x:Class="LiteCad.UI.Layout.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LiteCad.Resources"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="260">
    <Border Background="#FAFAFA"
            BorderBrush="#CCCCCC"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Loc Key=Label.Properties}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Margin="12,10,12,8" />

            <Border DockPanel.Dock="Top"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,12,12,12">
                    <TextBlock Text="{loc:Loc Key=Label.Tool}"
                               FontSize="11"
                               Foreground="#666666"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="ActiveToolText"
                               Text="{loc:Loc Key=Label.None}"
                               FontSize="13"
                               Margin="0,0,0,16" />

                    <TextBlock Text="{loc:Loc Key=Label.Selection}"
                               FontSize="11"
                               Foreground="#666666"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="SelectionText"
                               Text="{loc:Loc Key=Selection.NothingSelected}"
                               FontSize="13"
                               Margin="0,0,0,16" />

                    <StackPanel x:Name="LineToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.LineParameters}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{loc:Loc Key=Label.Color}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="LineColorCombo"
                                  Margin="0,0,0,12"
                                  SelectionChanged="LineColorCombo_OnSelectionChanged">
                            <ComboBoxItem Content="{loc:Loc Key=Label.Color.Black}" Tag="Black" IsSelected="True" />
                            <ComboBoxItem Content="{loc:Loc Key=Label.Color.Gray}" Tag="Gray" />
                            <ComboBoxItem Content="{loc:Loc Key=Label.Color.Blue}" Tag="Blue" />
                            <ComboBoxItem Content="{loc:Loc Key=Label.Color.Red}" Tag="Red" />
                            <ComboBoxItem Content="{loc:Loc Key=Label.Color.Green}" Tag="Green" />
                        </ComboBox>

                        <TextBlock Text="{loc:Loc Key=Label.Thickness}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="LineThicknessCombo"
                                  Margin="0,0,0,12"
                                  SelectionChanged="LineThicknessCombo_OnSelectionChanged">
                            <ComboBoxItem Content="1.0" Tag="1" />
                            <ComboBoxItem Content="1.5" Tag="1.5" IsSelected="True" />
                            <ComboBoxItem Content="2.0" Tag="2" />
                            <ComboBoxItem Content="3.0" Tag="3" />
                        </ComboBox>

                        <TextBlock Text="{loc:Loc Key=Label.Type}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="LineTypeCombo"
                                  Margin="0,0,0,12"
                                  SelectionChanged="LineTypeCombo_OnSelectionChanged">
                            <ComboBoxItem Content="{loc:Loc Key=Label.LineType.Solid}" Tag="Solid" IsSelected="True" />
                            <ComboBoxItem Content="{loc:Loc Key=Label.LineType.Dashed}" Tag="Dashed" />
                            <ComboBoxItem Content="{loc:Loc Key=Label.LineType.Dotted}" Tag="Dotted" />
                        </ComboBox>

                        <CheckBox x:Name="OrthoCheckBox"
                                  Content="{loc:Loc Key=Label.OrthoHorizontalVertical}"
                                  Margin="0,0,0,4"
                                  Checked="OrthoCheckBox_OnChanged"
                                  Unchecked="OrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="MoveToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.MoveParameters}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="MoveOrthoCheckBox"
                                  Content="{loc:Loc Key=Label.Ortho}"
                                  Margin="0,0,0,4"
                                  Checked="MoveOrthoCheckBox_OnChanged"
                                  Unchecked="MoveOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="MirrorToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.MirrorParameters}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="MirrorOrthoCheckBox"
                                  Content="{loc:Loc Key=Label.Ortho}"
                                  Margin="0,0,0,4"
                                  Checked="MirrorOrthoCheckBox_OnChanged"
                                  Unchecked="MirrorOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="DimensionToolPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.DimensionParameters}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Ножки:"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="DimensionToolExtensionStyleCombo"
                                  Margin="0,0,0,12"
                                  SelectionChanged="DimensionToolExtensionStyleCombo_OnSelectionChanged">
                            <ComboBoxItem Content="Полные" Tag="Full" IsSelected="True" />
                            <ComboBoxItem Content="Короткие" Tag="Short" />
                        </ComboBox>

                        <CheckBox x:Name="DimensionOrthoCheckBox"
                                  Content="{loc:Loc Key=Label.Ortho}"
                                  Margin="0,0,0,4"
                                  Checked="DimensionOrthoCheckBox_OnChanged"
                                  Unchecked="DimensionOrthoCheckBox_OnChanged" />
                    </StackPanel>

                    <StackPanel x:Name="DimensionSelectionPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=Label.DimensionParameters}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{loc:Loc Key=Label.Offset}"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="DimensionOffsetTextBox"
                                 Margin="0,0,0,12"
                                 LostFocus="DimensionOffsetTextBox_OnCommit"
                                 KeyDown="DimensionOffsetTextBox_OnKeyDown" />

                        <TextBlock Text="Ножки:"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="DimensionExtensionStyleCombo"
                                  Margin="0,0,0,12"
                                  SelectionChanged="DimensionExtensionStyleCombo_OnSelectionChanged">
                            <ComboBoxItem Content="Полные" Tag="Full" IsSelected="True" />
                            <ComboBoxItem Content="Короткие" Tag="Short" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock x:Name="NoParametersText"
                               Text="{loc:Loc Key=Label.NoParameters}"
                               FontSize="13"
                               Foreground="#999999" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
