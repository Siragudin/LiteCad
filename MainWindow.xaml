<Window x:Class="LiteCad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:layout="clr-namespace:LiteCad.UI.Layout"
        xmlns:loc="clr-namespace:LiteCad.Resources"
        mc:Ignorable="d"
        Title="{loc:Loc Key=Label.AppTitle}"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <layout:MenuBar x:Name="MainMenuBar"
                        Grid.Row="0" />

        <layout:ToolBar x:Name="MainToolBar"
                        Grid.Row="1" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="8,8,4,8"
                    BorderBrush="{StaticResource CadBorderDarkBrush}"
                    BorderThickness="1"
                    Background="White"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <layout:CanvasHost x:Name="MainCanvas"
                                   ClipToBounds="True"
                                   Session="{Binding Session}" />
            </Border>

            <layout:PropertiesPanel x:Name="MainProperties"
                                    Grid.Column="1" />
        </Grid>

        <layout:StatusBar x:Name="MainStatusBar"
                          Grid.Row="3" />
    </Grid>
</Window>
